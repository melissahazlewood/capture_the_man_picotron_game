:: button_actions.lua
--[[pod_format="raw",created="2025-09-02 18:25:51",modified="2025-09-15 22:40:52",revision=13]]
function handle_input(game)
	if (btn(2)) up_action(game)
	if (btn(3)) down_action(game)
	if (key("space")) spacebar_action(game)
end

function up_action(game)
	if not game.is_space_clicked then
		game.radius += 1
	end
end

function down_action(game)
	if not game.is_space_clicked then
		game.radius -= 1
	end
end

function spacebar_action(game)
	if not game.is_space_clicked then
		game.is_space_clicked = true
		game.time_elapsed = time() - game.time0
	end
end
:: config.lua
--[[pod_format="raw",created="2025-09-02 18:41:29",modified="2025-09-18 21:30:57",revision=58]]
colors = {
	WHITE = 7,
	RED = 8,
	GREEN = 11
}

phases = {
        instructions = "instructions",
        gameplay = "gameplay",
        ending = "ending",
        scoreboard = "scoreboard",
        exit_game = "exit_game",
}
		
instructions_text = {
		"kill him...",
		"but don't\ntouch him"
	}

-- Set up window dimensions and window center point coordinates
window_table = {
	win_dim = 128,
	win_title = "Capture the Man!"
}

function window_table:make_window()
	window({
		height = window_table.win_dim, 
		width = window_table.win_dim,
		title = window_table.win_title})
end

center = {
	x = window_table.win_dim/2 - 1, -- x-value (px) of screen center
	y = window_table.win_dim/2 - 1 -- y-value (px) of screen center
}
:: drawing.lua
--[[pod_format="raw",created="2025-09-02 19:26:13",modified="2025-09-18 21:09:56",revision=181]]
function draw_objects(game) 
	-- Draw circle
	circ(game.center.x, game.center.y, game.radius, game.circle_color)
	-- Draw sprite
	sspr(1, 0, 0, 16, 16, 
			game.sprite_corner.x, game.sprite_corner.y, game.dim, game.dim)
end

function color_overlap(pixels)
	for pixel in all(pixels) do
		pset(pixel.x, pixel.y, colors.RED)
	end
end

function wrap_text(text, max_w)
	local out, line_ = {}, ""
	for word in all(split(text, " ")) do
		line_temp = line_..word.." "
		local w, _ = measure_w_h(line_temp)
		if w > max_w and line ~= "" then
			add(out, line_)
			line_ = word.." "
		else
			line_ = line_temp
		end
	end
	if line_ ~= "" then
		add(out, line_)
	end
	return out
end

function draw_text_box(text)
	local lines = wrap_text(text, 56)
	if #lines == 0 then return end

	local widths = {}
	local widest = 0
	h = 0
	for i = 1, #lines do
		local line_w, line_h = measure_w_h(lines[i])
		widths[i] = line_w
		widest = max(w, line_w)
		h += line_h
	end
		
	tb_w = 96
	tb_h0 = 32 -- text box height before stretching
	tb_h1 = h + #lines + 8 -- text box height after stretching
	
	tb_x0 = (126-tb_w)/2
	tb_y0 = 126-tb_h1
	
	sspr(128, 0, 0, tb_w, tb_h0, tb_x0, tb_y0, tb_w, tb_h1)
	line_h = h / #lines
	for i = 1, #lines do
		print(lines[i], (128 - widths[i])/2, tb_y0 + line_h*(i-1) + 6, 1)
	end
end
:: game_state.lua
--[[pod_format="raw",created="2025-09-18 16:33:10",modified="2025-09-19 14:56:08",revision=67]]
function new_game_state()
	local Game = {
		dim = 8, -- width and height of sprite
		center = { -- coordinates for the center of the circle, given window center
			x = center.x,
			y = center.y },
		is_space_clicked = false,
		time0 = 0,
		time_elapsed = 0,
		time_exited = 0,
		circle_color = colors.WHITE,
		instruction_index = 1,
		ending_msg_index = 1,
		overlap = {
			touched_pixels = {},
			touched_px_count = 0,
			avg_distance = 0,
			resolved = false,
		}
	}
	
	function Game:reset_round()
		Game.dim = 8
		Game.radius = Game.dim/2 - 1 -- set circle radius based on initial sprite size
		Game.is_space_clicked = false
		Game.time_elapsed = 0
		Game.circle_color = colors.WHITE
		Game.ending_msg_index = 0
		Game.sprite_corner = get_sprite_corner_coords(Game)
		Game.overlap = {
			touched_pixels = {},
			touched_px_count = 0,
			avg_distance = 0,
			resolved = false,
		}
	end
		
	function Game:set_phase(id)
		local handler = phase_handlers[id]
		assert(handler, "unknown phase "..tostr(id))
		Game.phase_id = id
		Game.phase = handler
		if Game.phase.enter then
			Game.phase.enter(Game)
		end
	end
	
	Game:reset_round()
	return Game
end
:: geometry.lua
--[[pod_format="raw",created="2025-09-02 19:13:59",modified="2025-09-02 23:39:28",revision=29]]
function get_bounding_box_coords(center, radius)
	local x0 = center.x - radius
	local y0 = center.y - radius
	local x1 = center.x + radius
	local y1 = center.y + radius
	return x0, y0, x1, y1
end

function get_bounding_box(center, radius)
	return {
		x0 = center.x - radius,
		y0 = center.y - radius,
		x1 = center.x + radius,
		y1 = center.y + radius,
	}
end

function get_bb_coords_from_tl_corner(top_left_corner, dim)
	local x0 = top_left_corner.x
	local y0 = top_left_corner.y
	local x1 = x0 + dim - 1
	local y1 = y0 + dim - 1
	return x0, y0, x1, y1
end

function get_bb_from_tl_corner(top_left_corner, dim)
	return {
		x0 = top_left_corner.x,
		y0 = top_left_corner.y,
		x1 = top_left_corner.x + dim - 1,
		y1 = top_left_corner.y + dim - 1
	}
end

function is_point_within_box(x, y, box)
	return x >= box.x0 and x <= box.x1 and
			 y >= box.y0 and y <= box.y1
end

function is_point_outside_box(x, y, box)
	return x < box.x0 or x > box.x1 or
			 y < box.y0 or y > box.y1
end

function is_hypotenuse_within_px_of_radius(dx, dy, radius, px)
		dr = sqrt(dx*dx + dy*dy)
		return dr >= radius - px  and dr <= radius
end

function distance_to_box(x, y, box)
	-- get closest point on box to x, y
	closest_x = mid(x, box.x0, box.x1)
	closest_y = mid(y, box.y0, box.y1)
	return sqrt((closest_x - x)*(closest_x - x) + (closest_y - y)*(closest_y - y))
end
:: helpers.lua
--[[pod_format="raw",created="2025-09-02 20:47:34",modified="2025-09-18 20:57:05",revision=35]]
function update_sprite_coords(game)
	game.sprite_corner = get_sprite_corner_coords(game)
end

function get_sprite_corner_coords(game)
	local sprite_corner =
	 	{ x = game.center.x - game.dim/2 + 1, 
		  y = game.center.y - game.dim/2 + 1 } -- coords of top left sprite corner
	return sprite_corner
end

function compute_sprite_overlap(game)
	local touched, sum, n = {}, 0, 0
	
	-- sprite bounds (inclusive)
	local sprite_box = get_bb_from_tl_corner(game.sprite_corner, game.dim)
	-- circle bounding box
	local circle_box = get_bounding_box(game.center, game.radius)
	
	for y = circle_box.y0, circle_box.y1 do -- go through y points of filled circle
		local dy = y - game.center.y
		for x = circle_box.x0, circle_box.x1 do -- go through x points of filled circle
			local dx = x - game.center.x
			-- only handle if x, y is on circle border
			if is_hypotenuse_within_px_of_radius(dx, dy, game.radius, 1) then
				-- only color the pixels within the sprite bounds red
				if is_point_within_box(x, y, sprite_box) then
					add(touched, { x = x, y = y})
				end
				-- only count points on the circle border outside sprite's box toward
				--	 avg distance calculation 
				if is_point_outside_box(x, y, sprite_box) then
					-- calculate distance from closest sprite point to x,y
					dist = distance_to_box(x, y, sprite_box)
					sum += dist
					n += 1
				end
			end
		end
	end
	local avg = n > 0 and  sum / n or 0
	return {
		touched_pixels = touched,
		touched_px_count = #touched,
		avg_distance = avg,
		resolved = true,
	}		
end

function measure_w_h(s)
	clip(0, 0, 0, 0)
	local w, h = print(s, 0, 0)
	clip()
	return w, h
end
:: main.lua
--[[pod_format="raw",created="2025-09-02 01:39:45",modified="2025-09-18 19:09:16",revision=618]]
include "config.lua"
include "button_actions.lua"
include "drawing.lua"
include "geometry.lua"
include "helpers.lua"
include "phase_transitions.lua"
include "game_state.lua"

local game

function _init()
	game = new_game_state()
	window_table.make_window()
	game:set_phase(phases.instructions)
end

function _update()
	local phase = game.phase
	if phase and phase.update then
		phase.update(game)
	end
end

function _draw()
	local phase = game.phase
	if phase and phase.draw then
		phase.draw(game)
	end
end


:: phase_transitions.lua
--[[pod_format="raw",created="2025-09-15 21:52:38",modified="2025-09-18 21:43:06",revision=110]]
phase_handlers = {
	instructions = {
		enter = 
			function(game)
				game.instruction_index = 1
			end,
		update =
			function(game)
				if btnp() ~= 0 then
					if game.instruction_index < #instructions_text then
						game.instruction_index += 1
					else
						game:set_phase(phases.gameplay)
					end
				end
			end, 
		draw = 
			function(game)
				cls()
				draw_text_box(instructions_text[game.instruction_index])
			end,
	},
	gameplay = {
		enter = 
			function(game)
				game:reset_round()
				game.time0 = time()
			end,
		update =
			function(game)
				handle_input(game)
				update_sprite_coords(game)
				
				if not game.is_space_clicked then
					game.dim += 0.1
					update_sprite_coords(game)
				else
					if not game.overlap.resolved then
						local overlap = compute_sprite_overlap(game)
						game.overlap = overlap
						game.circle_color = colors.GREEN
					end
					game:set_phase(phases.ending)
				end
			end, 
		draw = 
			function(game)
				cls()
				draw_objects(game)
				if game.overlap.resolved then
					color_overlap(game.overlap.touched_pixels)
				end
			end,
	},
	ending = {
		enter =
			function(game)
				local verdict = game.overlap.touched_px_count == 0 and "nice" or "ew"
				end_msgs = {
					string.format("You took %.2f seconds", game.time_elapsed),
					string.format("And touched %f px of him...", game.overlap.touched_px_count),
					verdict
				}
			end,
		update =
			function(game)
				if btnp() ~= 0 then
					if game.ending_msg_index < #end_msgs then
						game.ending_msg_index += 1
					else
						game:set_phase(phases.scoreboard)
					end
				end
			end, 
		draw =
			function(game)
				cls()
				draw_objects(game)
				color_overlap(game.overlap.touched_pixels)
				draw_text_box(end_msgs[game.ending_msg_index])
			end,
	},
	scoreboard = {
		draw =
			function(game)
				cls()
				y = 36
				print(string.format("Time: %.2f sec", game.time_elapsed), 24, y, colors.WHITE)
				print("Overlap: "..game.overlap.touched_px_count, 24, y + 12, colors.WHITE)
				print(string.format("Avg dist: %.2f px", game.overlap.avg_distance), 24, y + 24, colors.WHITE)
				print("Play again? (y/n)", 24, y + 40, colors.WHITE)
			end,
		update =
			function(game)
				if keyp("n") then
					game.time_exited = time()
					game:set_phase(phases.exit_game)
				elseif keyp("y") then
					game:set_phase(phases.instructions)
				end
			end,
	},
	exit_game = {
		update = 
			function(game)
				if time() - game.time_exited > .75 then
					exit()
				end
			end,
		draw = 
			function(game)
				cls()
				print("Exiting...", 0, 0, colors.WHITE)
			end
	},
}
