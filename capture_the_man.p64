:: button_actions.lua
--[[pod_format="raw",created="2025-09-02 18:25:51",modified="2025-09-20 22:53:57",revision=48]]
function handle_input(game)
	if (btn(2)) up_action(game)
	if (btn(3)) down_action(game)
	if (key("space")) spacebar_action(game)
end

function up_action(game)
	game.capture_zone:grow(1)
end

function down_action(game)
	game.capture_zone:shrink(1)
end

function spacebar_action(game)
	if game.capture_zone.is_size_locked() then
		return
	end
	game.capture_zone.lock_size()
	game.target.lock_size()
	game.timer:stop_timer()
end
:: config.lua
--[[pod_format="raw",created="2025-09-02 18:41:29",modified="2025-09-21 06:48:36",revision=64]]
colors = {
	WHITE = 7,
	RED = 8,
	GREEN = 11
}

phases = {
        instructions = "instructions",
        gameplay = "gameplay",
        ending = "ending",
        scoreboard = "scoreboard",
        exit_game = "exit_game",
}
		
instructions_text = {
		"Try to catch him with your circle trap...",
		"but don't touch him....",
		"HE IS...",
		"THE PINK-FACED MAN",
		"Up Arrow: Increase trap radius",
		"Down Arrow: Decrease trap radius",
		"Space Bar: Set trap",
		"You have one shot...GO!"
	}

-- Set up window dimensions and window center point coordinates
window_table = {
	win_dim = 128,
	win_title = "Capture the Man!"
}

function window_table:make_window()
	window({
		height = window_table.win_dim, 
		width = window_table.win_dim,
		title = window_table.win_title})
end

center = {
	x = window_table.win_dim/2 - 1, -- x-value (px) of screen center
	y = window_table.win_dim/2 - 1 -- y-value (px) of screen center
}
:: drawing.lua
--[[pod_format="raw",created="2025-09-02 19:26:13",modified="2025-09-21 07:00:20",revision=289]]
local FACE_SHEETS = {
	{ expr="smirking", lids="open", gaze="up", side="right", sheet = 4 },
	{ expr="smirking", lids="open", gaze="up", side="left", sheet = 6 },
	{ expr="smirking", lids="open",	gaze="down", side="right", sheet = 0 },	
	{ expr="smirking", lids="open", gaze="down", side="left", sheet = 2 },
	{ expr="smirking", lids="closed", sheet = 8 },
	
	{ expr="fine", lids="open", gaze="up", side="right", sheet = 5 },
	{ expr="fine", lids="open", gaze="up", side="left", sheet = 7 },
	{ expr="fine", lids="open", gaze="down", side="right", sheet = 1 },
	{ expr="fine", lids="open", gaze="down", side="left", sheet = 3 },
	{ expr="fine", lids="closed", sheet = 9 },

	{ expr="angry", lids="open", sheet = 10 },
	{ expr="angry", lids="closed", sheet = 11 }
}

function resolve_sheet(s)
	for row in all(FACE_SHEETS) do
		if (row.expr == s.expr or not row.expr)
		and (row.lids == s.lids or not row.lids)
		and (row.gaze == s.gaze or not row.gaze)
		and (row.side == s.side or not row.side) then
		return row.sheet
		end
	end
end

function draw_objects(sheet, game)
	local zone, target = game.capture_zone, game.target
	
	local center, radius = zone:get_center(), zone:get_radius()
	circ(center.x, center.y, radius, zone:get_color())
	
	local corner, dimension = target:get_corner(), target:get_dimension()
	sspr(sheet, 0, 0, 16, 16, corner.x, corner.y, dimension, dimension)
end

local MUSIC_BUTTON_SPRITES = {
	on = { sheet = 48},
	off = { sheet = 49},
	hover_on = { sheet = 50},
	hover_off = { sheet = 51}
}

function draw_music_button(game)
	local hover = is_mouse_on_music_button(game)
	local sprite_key
	if game.music_controller.is_music_playing() then
		sprite_key = hover and "hover_on" or "on"
	else
		sprite_key = hover and "hover_off" or "off"
	end
	local sprite = MUSIC_BUTTON_SPRITES[sprite_key]
	sspr(sprite.sheet, 0, 0, 18, 18, 2, 2, 12, 12)
end

function color_overlap(pixels)
	for pixel in all(pixels) do
		pset(pixel.x, pixel.y, colors.RED)
	end
end

function draw_text_box(text)
	local lines = wrap_text(text, 56)
	if #lines == 0 then return end

	local widths = {}
	h = 0
	for i = 1, #lines do
		local line_w, line_h = measure_w_h(lines[i])
		widths[i] = line_w
		h += line_h
	end
		
	tb_w = 96
	tb_h0 = 32 -- text box height before stretching
	tb_h1 = h + #lines + 8 -- text box height after stretching
	
	tb_x0 = (126-tb_w)/2
	tb_y0 = 126-tb_h1
	
	sspr(128, 0, 0, tb_w, tb_h0, tb_x0, tb_y0, tb_w, tb_h1)
	line_h = h / #lines
	for i = 1, #lines do
		print(lines[i], (128 - widths[i])/2, tb_y0 + line_h*(i-1) + 6, 1)
	end
end
:: face_manager.lua
--[[pod_format="raw",created="2025-09-21 06:34:58",modified="2025-09-21 07:01:23",revision=12]]
function new_face_manager()
	local face_manager = {
		face = { expr = "fine", lids = "open", gaze = "down", side = "right" },
		phase = "gameplay",
		next_shuffle_at = time() + 0.2,
		shuffle_interval_min = 0.4,
		shuffle_interval_max = 0.9,
		
		next_blink_at = time() + rr(1.2, 2.4),
		blink_until = 0,
		blink_dur = 0.12,  -- ~7 frames at 60fps
	}
	
	function face_manager:resolve_face_sheet()
		return resolve_sheet(face_manager.face)
	end
	
	function face_manager:set_phase(p)
		face_manager.phase = p
		if p == "angry_only" then
			face_manager.face.expr = "angry"
		end
	end

	function face_manager:set_expression(expr)
		face_manager.face.expr = expr
	end
	
	function face_manager:set_eyelids(lids)
		face_manager.face.lids = lids
	end

	function face_manager:set_gaze(dir)
		face_manager.face.gaze = dir
	end

	function face_manager:set_side(s)
		face_manager.face.side = s
	end
	
	function face_manager:blink(now)
		-- start a blink?
		if now >= face_manager.next_blink_at and now >= face_manager.blink_until then
			face_manager.face.lids = "closed"
			face_manager.blink_until = now + face_manager.blink_dur
			face_manager.next_blink_at = now + rr(1.3, 2.8)
		end
		-- end current blink?
		if face_manager.face.lids == "closed" and now >= face_manager.blink_until then
			face_manager.face.lids = "open"
		end
	end
	
	function face_manager:shuffle(now)
		if now < face_manager.next_shuffle_at then return end
		
		face_manager.next_shuffle_at = now + 
						rr(face_manager.shuffle_interval_min, face_manager.shuffle_interval_max)
		
		if face_manager.phase == "gameplay" then
			face_manager.face.expr = choice({"fine", "smirking"})
			face_manager.face.gaze = choice({"down", "up"})
			face_manager.face.side = choice({"right", "left"})
		elseif face_manager.phase == "angry_only" then
			face_manager.face.expr = "angry"
		end
	end
	
	function face_manager:update()
		local now = time()
		face_manager:blink(now)
		face_manager:shuffle(now)
	end

	return face_manager
end

