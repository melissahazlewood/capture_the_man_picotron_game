--[[pod_format="raw",created="2025-09-18 16:33:10",modified="2025-09-20 20:38:09",revision=108]]
include "components/target.lua"
include "components/capture_zone.lua"
include "components/round_timer.lua"
include "components/overlap_report.lua"
include "phase_manager.lua"

function new_game_state()
	local Game = {
		target = new_target(center),
		capture_zone = new_capture_zone(center),
		timer = new_timer(),
		overlap = new_overlap_report(),
		music_controller = new_music_controller(),
		phase_manager = new_phase_manager({
			[phases.instructions] = new_instructions_phase(),
			[phases.gameplay] = new_gameplay_phase(),
			[phases.ending] = new_ending_phase(),
			[phases.scoreboard] = new_scoreboard_phase(),
			[phases.exit_game] = new_exit_game_phase(),
		}),
		time_exited = 0,
		mouse_info = {
			x = 0, y = 0, left_click = false, left_click_pressed = false},
		show_mouse_overlay = false, 
		music_on = true
	}
	
	function Game:reset_round()
		Game.target:reset_target()
		Game.capture_zone:reset_zone()
		Game.timer:reset_timer()
		Game.overlap:reset_overlap()

		Game.ending_msg_index = 1
	end
		
	function Game:set_phase(id)
		Game.phase_manager:transition_phases(id, Game)
	end
	
	function Game:update()
		Game.phase_manager:update(Game)
	end
	
	function Game:draw()
		Game.phase_manager:draw(Game)
	end
	
	Game:reset_round()
	return Game
end
:: geometry.lua
--[[pod_format="raw",created="2025-09-02 19:13:59",modified="2025-09-20 16:26:28",revision=32]]
function get_bb_from_tl_corner(top_left_corner, dim)
	return {
		x0 = top_left_corner.x,
		y0 = top_left_corner.y,
		x1 = top_left_corner.x + dim - 1,
		y1 = top_left_corner.y + dim - 1
	}
end

function get_bounding_box(center, radius)
	return {
		x0 = center.x - radius,
		y0 = center.y - radius,
		x1 = center.x + radius,
		y1 = center.y + radius,
	}
end

function is_point_within_box(x, y, box)
	return x >= box.x0 and x <= box.x1 and
			 y >= box.y0 and y <= box.y1
end

function is_point_outside_box(x, y, box)
	return x < box.x0 or x > box.x1 or
			 y < box.y0 or y > box.y1
end

function is_hypotenuse_within_px_of_radius(dx, dy, radius, px)
		dr = sqrt(dx*dx + dy*dy)
		return dr >= radius - px  and dr <= radius
end

function distance_to_box(x, y, box)
	-- get closest point on box to x, y
	closest_x = mid(x, box.x0, box.x1)
	closest_y = mid(y, box.y0, box.y1)
	return sqrt((closest_x - x)*(closest_x - x) + (closest_y - y)*(closest_y - y))
end
:: helpers.lua
--[[pod_format="raw",created="2025-09-02 20:47:34",modified="2025-09-20 19:12:14",revision=84]]
function measure_w_h(s)
	clip(0, 0, 0, 0)
	local w, h = print(s, 0, 0)
	clip()
	return w, h
end

function get_mouse_info(game)
	local mx, my, mb, _, _ = mouse()
	local left_click = (mb == 0x1)
	local prev_left_down = game.mouse_info and game.mouse_info.left_click or false
	game.mouse_info = { 
		x = mx,
		y = my,
		left_click = left_click,
		left_click_pressed = left_click and not prev_left_down
	}
end

function handle_music_toggle(game)
	if is_mouse_on_music_button(game)
		and game.mouse_info.left_click_pressed then
			game.music_controller:toggle_music()
	end
end

function is_mouse_on_button(mx, my, button_tl_corner, bw, bh)
	local x, y = button_tl_corner.x, button_tl_corner.y
   return mx >= x and mx <= x + bw 
   		and my >= y and my <= y + bh
end

function is_mouse_on_music_button(game)
	return is_mouse_on_button(game.mouse_info.x, game.mouse_info.y,
		{x = 2, y = 2}, 12, 12)
end
:: main.lua
--[[pod_format="raw",created="2025-09-02 01:39:45",modified="2025-09-20 21:01:16",revision=684]]
include "config.lua"
include "button_actions.lua"
include "drawing.lua"
include "geometry.lua"
include "helpers.lua"
include "phase_manager.lua"
include "game_state.lua"
include "components/music_controller.lua"

local game

function _init()
	game = new_game_state()
	window_table.make_window()
	game.music_controller:play_music()
	game:set_phase(phases.instructions)
end

function _update()
	get_mouse_info(game)
	handle_music_toggle(game)
	game:update()
end

function _draw()
	game:draw()
end


:: phase_manager.lua
--[[pod_format="raw",created="2025-09-20 19:47:38",modified="2025-09-20 20:52:45",revision=9]]
include "phases/instructions.lua"
include "phases/gameplay.lua"
include "phases/ending.lua"
include "phases/scoreboard.lua"
include "phases/exit_game.lua"

function new_phase_manager(registry)
	local manager = {
		registry = registry,
		current_phase_id = nil,
		current_phase = nil
	}
	
	function manager:transition_phases(id, game)
		local phase = registry[id]
		assert(phase, "unknown phase "..tostr(id))
		manager.current_phase_id = id
		manager.current_phase = phase
		if phase.enter then
			phase:enter(game)
		end
	end
	
	function manager:update(game)
		if manager.current_phase and manager.current_phase.update then
			manager.current_phase:update(game)
		end
	end
	
	function manager:draw(game)
		if manager.current_phase and manager.current_phase.draw then
			manager.current_phase:draw(game)
		end
	end

	return manager
end
