:: phases/
:: phases/ending.lua
--[[pod_format="raw",created="2025-09-20 19:41:08",modified="2025-09-20 21:01:38",revision=2]]
function new_ending_phase()
	local phase = {
		msg_index = 1,
		messages = {}
	}
	
	function phase:enter(game)
		local is_untouched = game.overlap:get_pixel_count() == 0
		local verdict = is_untouched and "nice" or "ew"
		phase.messages = {
			string.format("You took %.2f seconds", game.timer.time_elapsed),
			string.format("And touched %f px of him...", game.overlap.touched_px_count),
			verdict
		}
	end
	
	function phase:update(game)
		if btnp() ~= 0 then
			if phase.msg_index < #phase.messages then
				phase.msg_index += 1
			else
				game:set_phase(phases.scoreboard)
			end
		end
	end
	
	function phase:draw(game)
		cls()
		draw_music_button(game)
		draw_objects(game)
		color_overlap(game.overlap:get_pixels())
		draw_text_box(phase.messages[phase.msg_index])
	end
	
	return phase
end
:: phases/exit_game.lua
--[[pod_format="raw",created="2025-09-15 21:52:38",modified="2025-09-20 19:41:41",revision=154]]
function new_exit_game_phase()
	phase = {}
	
	function phase:update(game)
		if time() - game.time_exited > .75 then
			exit()
		end
	end
	
	function phase:draw(game)
		cls()
		print("Exiting...", 0, 0, colors.WHITE)
	end

	return phase
end
:: phases/gameplay.lua
--[[pod_format="raw",created="2025-09-20 19:40:55",modified="2025-09-20 21:01:13",revision=4]]
function new_gameplay_phase()
	local phase = {}
	
	function phase:enter(game)
		game:reset_round()
		game.timer:start_timer()
	end
	
	function phase:update(game)
		handle_input(game)
		if not game.capture_zone.is_size_locked() then
			game.target:grow(0.1)
		else
			if not game.overlap:is_resolved() then
				local overlap_computation_results = game.target:compute_overlap(game.capture_zone)
				game.overlap:apply(overlap_computation_results)
				game.capture_zone:set_color(colors.GREEN)
			end
			game:set_phase(phases.ending)
		end
	end

	function phase:draw(game)
		cls()
		draw_music_button(game)
		draw_objects(game)
		if game.overlap:is_resolved() then
			color_overlap(game.overlap:get_pixels())
		end
	end
	
	return phase
end
:: phases/instructions.lua
--[[pod_format="raw",created="2025-09-20 19:40:36",modified="2025-09-20 21:02:01",revision=11]]
function new_instructions_phase()
	local phase = {
		instruction_index = 1
	}
	
	function phase:enter(game)
		phase.instruction_index = 1
	end
	
	function phase:update(game)
		if btnp() ~= 0 then
			if phase.instruction_index < #instructions_text then
				phase.instruction_index += 1
			else
				game:set_phase(phases.gameplay)
			end
		end
	end
	
	function phase:draw(game)
		cls()
		draw_music_button(game)
		draw_text_box(instructions_text[phase.instruction_index])
	end
	
	return phase
end
:: phases/scoreboard.lua
--[[pod_format="raw",created="2025-09-20 19:41:25",modified="2025-09-20 21:01:54",revision=4]]
function new_scoreboard_phase()
	local phase = {
		x = 24,
		y = 36,
	}
	
	function phase:draw(game)
		cls()
		draw_music_button(game)
		print(string.format("Time: %.2f sec", game.timer.time_elapsed), 
			phase.x, phase.y, colors.WHITE)
		print("Overlap: "..game.overlap:get_pixel_count().." px", 
			phase.x, phase.y + 12, colors.WHITE)
		print(string.format("Avg dist: %.2f px", game.overlap.avg_distance), 
			phase.x, phase.y + 24, colors.WHITE)
		print("Play again? (y/n)",
			phase.x, phase.y + 40, colors.WHITE)
	end
	
	function phase:update(game)
		if keyp("n") then
			game.time_exited = time()
			game:set_phase(phases.exit_game)
		elseif keyp("y") then
			game:set_phase(phases.instructions)
		end
	end
	
	return phase
end

