:: components/capture_zone.lua
--[[pod_format="raw",created="2025-09-20 15:53:35",modified="2025-09-20 17:59:05",revision=17]]
function new_capture_zone(center)
	local capture_zone = {
		radius = 3,
		center = { -- coordinates for the center of the circle, given window center
			x = center.x,
			y = center.y
		},
		outline_color = colors.WHITE,
		size_locked = false
	}
	
	function capture_zone:reset_zone()
		capture_zone.radius = 3
		capture_zone.center = { -- coordinates for the center of the circle, given window center
			x = center.x,
			y = center.y
		}
		capture_zone.outline_color = colors.WHITE
		capture_zone.size_locked = false
	end
	
	function capture_zone:grow(amount)
		if not capture_zone.size_locked then
			capture_zone.radius += amount
		end
	end
	
	function capture_zone:shrink(amount)
		if not capture_zone.size_locked then
			capture_zone.radius = max(1, capture_zone.radius - amount)
		end
	end
	
	function capture_zone:lock_size()
		capture_zone.size_locked = true
	end
	
	function capture_zone:is_size_locked()
		return capture_zone.size_locked
	end
	
	function capture_zone:get_radius()
		return capture_zone.radius
	end
	
	function capture_zone:get_center()
		return capture_zone.center
	end
	
	function capture_zone:get_color()
		return capture_zone.outline_color
	end
	
	function capture_zone:set_color(new_color)
		capture_zone.outline_color = new_color
	end

	return capture_zone
end
:: components/music_controller.lua
--[[pod_format="raw",created="2025-09-20 18:52:10",modified="2025-09-21 06:44:10",revision=7]]
function new_music_controller()
	local controller = {
		channel = 1,
		sounds_are_loaded = false,
		playing = false
	}
	
	function controller:reset_controller()
		channel = 1
		sounds_loaded = false
		playing = false
	end
	
	function controller:load_sounds()
		if controller.sounds_are_loaded then
			return
		end
		fetch("sfx/1.sfx"):poke(0x80000) -- load 256k into 0x80000..0xbffff
		controller.sounds_are_loaded = true
	end
	
	function controller:play_music()
		controller:load_sounds()
		if controller.playing then
			return
		end
		music(controller.channel, nil, nil, 0x80000) -- play music using 0x80000 as the audio base address
		controller.playing = true
	end

	function controller:stop_music()
		music(-1)
		controller.playing = false
	end
	
	function controller:toggle_music()
		if controller.playing then
			controller:stop_music()
		else
			controller:play_music()
		end
	end
	
	function controller:is_music_playing()
		return controller.playing
	end
	
	return controller
end
:: components/overlap_report.lua
--[[pod_format="raw",created="2025-09-20 18:28:12",modified="2025-09-20 18:44:43",revision=7]]
function new_overlap_report()
	local overlap = {
		touched_pixels = {},
		touched_px_count = 0,
		avg_distance = 0,
		resolved = false,
	}
	
	function overlap:reset_overlap()
		overlap.touched_pixels = {}
		overlap.touched_px_count = 0
		overlap.avg_distance = 0
		overlap.resolved = false
	end
	
	function overlap:get_pixels()
		return overlap.touched_pixels
	end
	
	function overlap:get_pixel_count()
		return overlap.touched_px_count
	end
		
	function overlap:get_avg_distance()
		return overlap.avg_distance
	end
	
	function overlap:is_resolved()
		return overlap.resolved
	end
	
	function overlap:apply(computation_result)
		overlap.touched_pixels = computation_result.touched_pixels or {}
		overlap.touched_px_count = computation_result.touched_px_count or #computation_result.touched_pixels
		overlap.avg_distance = computation_result.avg_distance
		overlap.resolved = computation_result.resolved
	end
	
	return overlap
end
:: components/round_timer.lua
--[[pod_format="raw",created="2025-09-20 18:03:35",modified="2025-09-20 18:17:11",revision=6]]
function new_timer()
	local timer = {
		time0 = 0,
		time_elapsed = 0
	}
	
	function timer:reset_timer()
		timer.time0 = 0
		time_elapsed = 0
	end
	
	function timer:start_timer()
		timer.time0 = time()
	end
	
	function timer:stop_timer()
		timer.time_elapsed = time() - timer.time0
	end
	
	return timer
end
:: components/target.lua
--[[pod_format="raw",created="2025-09-20 17:59:42",modified="2025-09-20 18:17:56",revision=3]]
function new_target(center)
	local target = {
		dim = 8, --width and height of target sprite
		size_locked = false
	}
	
	function target:reset_target()
		target.dim = 8
		target.size_locked = false
	end
	
	function target:grow(amount)
		if not target.size_locked then
			target.dim += amount
		end
	end
	
	function target:shrink(amount)
		if not target.size_locked then
			target.dim = max(1, target.dim - 1)
		end
	end
	
	function target:lock_size()
		target.size_locked = true
	end
	
	function target:is_size_locked()
		return target.size_locked
	end
	
	function target:get_dimension()
		return target.dim
	end
	
	function target:get_corner() --top left corner
		return {
			x = center.x - target.dim/2 + 1, 
			y = center.y - target.dim/2 + 1 }
	end
	
	function target:get_bounds()
		return get_bb_from_tl_corner(target:get_corner(), target.dim)
	end
	
	function target:compute_overlap(capture_zone)
		local touched, sum, n = {}, 0, 0
		local target_box = target:get_bounds()
		local zone_center, zone_radius = capture_zone:get_center(), capture_zone:get_radius()
		local zone_box = get_bounding_box(zone_center, zone_radius)
		
		for y = zone_box.y0, zone_box.y1 do
			local dy = y - zone_center.y
			for x = zone_box.x0, zone_box.x1 do
				local dx = x - zone_center.x
				if is_hypotenuse_within_px_of_radius(dx, dy, zone_radius, 1) then
					if is_point_within_box(x, y, target_box) then
						add(touched, { x = x, y = y})
					end 
					if is_point_outside_box(x, y, target_box) then
						sum += distance_to_box(x, y, target_box)
						n += 1
					end
				end
			end
		end
		local avg = n > 0 and  sum / n or 0
		return {
			touched_pixels = touched,
			touched_px_count = #touched,
			avg_distance = avg,
			resolved = true,
		}		
	end
	
	return target

end

